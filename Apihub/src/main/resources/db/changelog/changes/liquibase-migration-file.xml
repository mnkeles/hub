    <changeSet id="2026-07-12-012-seed-default-role-permissions" author="apihub">
        <sql>
            INSERT INTO role_permissions (role_id, permission_id)
            SELECT r.role_id, p.permission_id
            FROM roles r
            CROSS JOIN permissions p
            WHERE r.short_code = 'ROLE_ADMIN'
            ON CONFLICT (role_id, permission_id) DO NOTHING;

            INSERT INTO role_permissions (role_id, permission_id)
            SELECT r.role_id, p.permission_id
            FROM roles r
            JOIN permissions p ON p.permission_key IN (
                'MENU.DASHBOARD.VIEW',
                'MENU.API_INFORMATION.VIEW',
                'MENU.PROCESS_FLOWS.VIEW',
                'MENU.API_EXECUTOR.VIEW',
                'MENU.DOCUMENTS.VIEW',
                'MENU.USER.VIEW',
                'MENU.AI_CHAT.VIEW',
                'PROJECT.VIEW',
                'API_INFORMATION.VIEW',
                'PROCESS_FLOW.VIEW',
                'API_CALL.EXECUTE',
                'PERFORMANCE.HISTORY.VIEW',
                'AI_CHAT.USE',
                'AI_CHAT.HISTORY.VIEW'
            )
            WHERE r.short_code = 'ROLE_USER'
            ON CONFLICT (role_id, permission_id) DO NOTHING;

            INSERT INTO role_permissions (role_id, permission_id)
            SELECT r.role_id, p.permission_id
            FROM roles r
            JOIN permissions p ON p.permission_key IN (
                'PROJECT.VIEW',
                'PROCESS_FLOW.VIEW',
                'API_CALL.EXECUTE'
            )
            WHERE r.short_code = 'ROLE_SERVICE'
            ON CONFLICT (role_id, permission_id) DO NOTHING;
        </sql>
    </changeSet>

